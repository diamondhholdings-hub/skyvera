{
  "name": "skyvera-intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "refresh-data": "python3 scripts/parse_excel_to_json.py --type all 2>/dev/null > src/data/skyvera-snapshot.json && python3 scripts/extract_dm_data.py 2>/dev/null > src/data/dm-tracker-snapshot.json && echo 'Snapshots updated: src/data/skyvera-snapshot.json, src/data/dm-tracker-snapshot.json'",
    "generate-demo-data": "npx tsx scripts/generate-demo-data.ts",
    "warmup": "npx tsx scripts/warmup-cache.ts",
    "enrich:accounts": "npx tsx scripts/enrich-accounts.ts",
    "test:unit": "vitest run tests/unit",
    "test:unit:ui": "vitest --ui tests/unit",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@libsql/client": "^0.17.0",
    "@prisma/adapter-libsql": "^7.3.0",
    "@prisma/client": "5.22.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/jsforce": "^1.11.6",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.24",
    "better-sqlite3": "^12.6.2",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "jsforce": "^3.10.14",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "postcss": "^8.5.6",
    "prisma": "5.22.0",
    "rate-limiter-flexible": "^9.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.2.2",
    "@vitest/ui": "^4.1.2",
    "dotenv": "^17.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
