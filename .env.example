# Claude goes through the TrueFoundry AI gateway, which holds the provider keys.
# TFY_BASE_URL and TFY_MODEL_GROUP default to the values shown.
TFY_API_KEY=your_truefoundry_api_key_here
# TFY_BASE_URL=https://tfy.promptlens.trilogy.com
# TFY_MODEL_GROUP=claude-group

# Fallback only: calls Anthropic directly when TFY_API_KEY is not set
# ANTHROPIC_API_KEY=

# NewsAPI.ai for real-time business news intelligence
# Get your key from: https://newsapi.ai/account
NEWSAPI_KEY=your_newsapi_key_here

# RapidAPI Key — single key for all RapidAPI integrations
# Get your key from: https://rapidapi.com/developer/apps → Security tab
RAPIDAPI_KEY=your_rapidapi_key_here

# Notion Integration for bidirectional database sync
# Get your integration key from: https://www.notion.so/my-integrations
# Create an internal integration and share your databases with it
NOTION_API_KEY=your_notion_api_key_here

# Notion Database IDs (optional - configure as needed)
# To get database ID: Open database in Notion, copy the URL
# Format: https://notion.so/<workspace>/<database_id>?v=<view_id>
# Use the <database_id> part (32-character string)
NOTION_DATABASE_ACCOUNT_PLANS=
NOTION_DATABASE_CUSTOMERS=
NOTION_DATABASE_ALERTS=
NOTION_DATABASE_ACTION_ITEMS=
NOTION_DATABASE_INTELLIGENCE=

# Database URL for Prisma
DATABASE_URL="file:./dev.db"

# Salesforce Integration (optional — enables Sync from Salesforce button)
SALESFORCE_INSTANCE_URL=https://yourinstance.salesforce.com
SALESFORCE_USERNAME=your@email.com
SALESFORCE_PASSWORD=yourpassword
SALESFORCE_SECURITY_TOKEN=yoursecuritytoken
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
